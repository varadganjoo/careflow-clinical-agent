# Copy this file to .env and set your Google Gemini API key.
# Uses Gemini 3.8 Flash (September 2026) for fast triage, reasoning, and clinical SOAP extraction.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
PORT=8010
MCP_PORT=8011
