# ==============================================================================
# CareFlow Clinical Agent - Environment Configuration
# ==============================================================================
# Copy this file to .env and set your Google Gemini API key.
# Models tried in order on quota, overload, or unavailable-model errors.

GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODELS=gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash
PORT=8010
MCP_PORT=8011
